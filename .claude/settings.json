{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 scripts/update_news.py:*)",
      "Bash(python3 scripts/validate_site.py:*)",
      "Bash(python3 scripts/test_update_news.py:*)",
      "Bash(python3 scripts/fetch_rss_news.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add data/news.json)",
      "Bash(git pull origin main)",
      "Bash(git fetch origin:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr:*)",
      "Bash(rm -fr *)",
      "Bash(git push --force:*)",
      "Bash(git push --force *)",
      "Bash(git push -f:*)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard:*)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fd *)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-branch *)",
      "Bash(git rebase:*)",
      "Bash(git rebase *)",
      "Bash(git commit --amend:*)",
      "Bash(git commit --amend *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.csv)",
      "Read(./**/*.xlsx)",
      "Edit(./.git/**)"
    ]
  }
}
